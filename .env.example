# Copie ce fichier en .env puis remplis tes clés. Git ignore .env.
# Jamais de ANTHROPIC_API_KEY : Claude tourne sur ton abonnement Max.

# Transcription mot à mot (recommandée)
ELEVENLABS_API_KEY=

# B-roll et images IA (optionnelle)
FAL_KEY=

# Choix visage/écran par un modèle (optionnelle)
OPENROUTER_API_KEY=

# Musique et bruitages, si ton abonnement donne accès à l'API (optionnelle)
EPIDEMIC_API_KEY=
